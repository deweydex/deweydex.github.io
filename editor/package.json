{
  "name": "edit",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test ./src",
    "build": "bun build ./src/main.ts ./src/inplace.ts --outdir ../public/edit --minify --entry-naming '[name].[ext]' && bun ./scripts/page.ts",
    "roundtrip": "bun ./scripts/roundtrip.ts",
    "e2e": "bun scripts/e2e.ts && bun scripts/e2e-inplace.ts && bun scripts/e2e-github.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@milkdown/crepe": "7.21.3",
    "@milkdown/kit": "7.21.3",
    "js-yaml": "^5.4.2",
    "katex": "^0.18.7",
    "markdown-it": "^15.0.1",
    "markdown-it-texmath": "^1.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
